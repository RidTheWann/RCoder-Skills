#!/usr/bin/env python3
"""Build reproducible standalone Agent Skill and plugin ZIPs with stdlib only."""
from pathlib import Path
import hashlib
import stat
import zipfile

ROOT = Path(__file__).resolve().parent.parent
SKILL = ROOT / "skills" / "rcoder"
DIST = ROOT / "dist"
VERSION = '1.16.0'
FIXED_TIME = (2026, 1, 1, 0, 0, 0)
EXCLUDED_DIRS = {
    ".git", ".mcp-live-test", "dist", "__pycache__", ".venv", "venv",
    "node_modules", ".pytest_cache", ".mypy_cache", "target", "build",
    ".ssh", ".aws", ".gnupg", ".kube",
}


def is_excluded(relative: Path) -> bool:
    parts = relative.parts
    if any(part in EXCLUDED_DIRS for part in parts):
        return True
    if len(parts) >= 4 and parts[0] == "evals" and parts[1] == "runs" and parts[3] == "raw":
        return True
    if not parts:
        return False
    name = parts[-1].lower()
    if name.startswith(".env") or name in {
        ".npmrc", ".pypirc", ".netrc", ".git-credentials", ".ds_store",
        "credentials", "credentials.json", "secrets.json", "secrets.yaml", "secrets.yml",
        "secrets.toml", "terraform.tfstate", ".htpasswd", ".dockercfg",
    }:
        return True
    if name.endswith((".pem", ".key", ".p12", ".pfx", ".jks", ".keystore", ".kdbx", ".err")):
        return True
    if name.startswith("service-account") and name.endswith(".json"):
        return True
    return False


def add_file(archive, path, archive_name):
    info = zipfile.ZipInfo(archive_name, date_time=FIXED_TIME)
    info.compress_type = zipfile.ZIP_DEFLATED
    info.create_system = 3
    executable = bool(path.stat().st_mode & 0o111)
    info.external_attr = (stat.S_IFREG | (0o755 if executable else 0o644)) << 16
    archive.writestr(info, path.read_bytes(), compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)


def add_dir(archive, base, prefix):
    for path in sorted(item for item in base.rglob("*") if item.is_file()):
        relative = path.relative_to(base)
        if is_excluded(relative):
            continue
        add_file(archive, path, f"{prefix}/{relative.as_posix()}")


def main():
    if not (SKILL / "SKILL.md").is_file():
        raise SystemExit("Missing skills/rcoder/SKILL.md")
    DIST.mkdir(exist_ok=True)
    packages = [
        (f"rcoder-v{VERSION}.skill.zip", [(SKILL, "rcoder"), (ROOT / "runtime" / "bin", "runtime/bin")]),
        (f"rcoder-v{VERSION}.claude-plugin.zip", [(ROOT / ".claude-plugin", ".claude-plugin"), (ROOT / ".mcp.json", ".mcp.json"), (ROOT / "launcher" / "rcoder-mcp.mjs", "launcher/rcoder-mcp.mjs"), (ROOT / "commands", "commands"), (ROOT / "agents", "agents"), (ROOT / 'hooks', 'hooks'), (SKILL.parent, "skills"), (ROOT / "runtime" / "bin", "runtime/bin"), (ROOT / "LICENSE", "LICENSE"), (ROOT / "README.md", "README.md")]),
        (f"rcoder-v{VERSION}.agent-plugin.zip", [(ROOT / "plugin.json", "plugin.json"), (ROOT / "mcp.json", "mcp.json"), (ROOT / "launcher" / "rcoder-mcp.mjs", "launcher/rcoder-mcp.mjs"), (SKILL.parent, "skills"), (ROOT / "runtime" / "bin", "runtime/bin"), (ROOT / "LICENSE", "LICENSE"), (ROOT / "README.md", "README.md")]),
        (f"rcoder-v{VERSION}.codex-plugin.zip", [(ROOT / "plugin.json", "plugin.json"), (ROOT / ".codex-plugin", ".codex-plugin"), (ROOT / ".mcp.json", ".mcp.json"), (ROOT / "launcher" / "rcoder-mcp.mjs", "launcher/rcoder-mcp.mjs"), (SKILL.parent, "skills"), (ROOT / "runtime" / "bin", "runtime/bin"), (ROOT / "LICENSE", "LICENSE"), (ROOT / "README.md", "README.md")]),
        (f"rcoder-v{VERSION}.gemini-extension.zip", [(ROOT / "gemini-extension.json", "gemini-extension.json"), (ROOT / "GEMINI.md", "GEMINI.md"), (ROOT / "commands" / "rcoder", "commands/rcoder"), (ROOT / "launcher" / "rcoder-mcp.mjs", "launcher/rcoder-mcp.mjs"), (SKILL.parent, "skills"), (ROOT / "runtime" / "bin", "runtime/bin")]),
    ]
    checksums = []
    for filename, items in packages:
        output = DIST / filename
        with zipfile.ZipFile(output, "w") as archive:
            for base, prefix in items:
                if base.is_dir():
                    add_dir(archive, base, prefix)
                elif base.is_file():
                    add_file(archive, base, prefix)
                else:
                    raise SystemExit(f"Missing package input: {base}")
        digest = hashlib.sha256(output.read_bytes()).hexdigest()
        checksums.append(f"{digest}  {filename}")
        print(f"created {output.relative_to(ROOT)} ({output.stat().st_size} bytes, sha256 {digest})")
    source_output = DIST / f"rcoder-v{VERSION}-source.zip"
    with zipfile.ZipFile(source_output, "w") as archive:
        for path in sorted(item for item in ROOT.rglob("*") if item.is_file()):
            relative = path.relative_to(ROOT)
            if is_excluded(relative):
                continue
            add_file(archive, path, f"rcoder/{relative.as_posix()}")
    digest = hashlib.sha256(source_output.read_bytes()).hexdigest()
    checksums.append(f"{digest}  {source_output.name}")
    print(f"created {source_output.relative_to(ROOT)} ({source_output.stat().st_size} bytes, sha256 {digest})")
    (DIST / "SHA256SUMS").write_text("\n".join(checksums) + "\n", encoding="utf-8")
    print("created dist/SHA256SUMS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
