#!/usr/bin/env python3
"""Offline static quality gates for RCoder; no third-party packages required."""
import json,re
from pathlib import Path
ROOT=Path(__file__).resolve().parent.parent; SKILL=ROOT/'skills'/'rcoder'; errors=[]; count=0
def check(ok,msg):
 global count; count+=1
 if not ok: errors.append(msg)
def front(path):
 text=path.read_text(encoding='utf-8')
 if not text.startswith('---\n') or '\n---\n' not in text[4:]: return {},''
 end=text.find('\n---\n',4); raw=text[4:end]; meta={}
 for line in raw.splitlines():
  if line and not line[0].isspace() and ':' in line:
   k,v=line.split(':',1); v=v.strip()
   if v.startswith('"') and v.endswith('"'):
    try: v=json.loads(v)
    except json.JSONDecodeError: v=v[1:-1]
   elif v.startswith("'") and v.endswith("'"): v=v[1:-1]
   meta[k.strip()]=v
 return meta,text[end+5:]
def main():
 p=SKILL/'SKILL.md'; check(p.is_file(),'G1: missing SKILL.md')
 if not p.is_file(): return 1
 meta,body=front(p); name=meta.get('name',''); desc=meta.get('description','')
 check(name=='rcoder','G1: name must equal rcoder'); check(bool(re.fullmatch(r'[a-z0-9]+(?:-[a-z0-9]+)*',name)) and len(name)<=64,'G1: invalid name')
 check(isinstance(desc,str) and 1<=len(desc)<=1024,'G1: description length must be 1..1024')
 check(len(p.read_text(encoding='utf-8').splitlines())<=300,'G1: SKILL.md exceeds 300 lines'); check(bool(body.strip()),'G1: empty skill body')
 modules=['coding.md','architecture.md','ui-ux-accessibility.md','debugging.md','testing-qa.md','security.md','performance.md','devops-ci-cd.md','data-api.md','review-refactor.md','documentation.md','verification.md']
 sections=['## Activate when','## Mental model','## Procedure','## Quality checklist','## Anti-patterns','## Verification','## Output format']
 for n in modules:
  q=SKILL/'references'/n; check(q.is_file(),f'G1: missing module {n}')
  if q.is_file():
   t=q.read_text(encoding='utf-8'); check(len(t.splitlines())<=300,f'G1: {n} exceeds 300 lines')
   for h in sections: check(h in t,f'G1: {n} missing {h}')
 check((SKILL/'scripts'/'detect_stack.py').is_file(),'G1: missing detect_stack.py')
 check((SKILL/'assets'/'templates'/'expert-module-template.md').is_file(),'G1: missing expert module template')
 link=re.compile(r'\]\(([^)]+)\)')
 for md in ROOT.rglob('*.md'):
  for raw in link.findall(md.read_text(encoding='utf-8',errors='replace')):
   target=raw.strip().split()[0].strip('<>')
   if not target or target.startswith(('http://','https://','mailto:','#')): continue
   target=target.split('#',1)[0]
   if target: check((md.parent/target).resolve().exists(),f'G1: broken link {md.relative_to(ROOT)} -> {target}')
 for md in (SKILL/'references').glob('*.md'):
  for target in link.findall(md.read_text(encoding='utf-8',errors='replace')):
   check(not target.split('#',1)[0].startswith('references/'),f'G1: chained reference link in {md.name}')
 try:
  data=json.loads((ROOT/'evals'/'triggers.json').read_text(encoding='utf-8')); yes=[x for x in data if x.get('should_trigger') is True]; no=[x for x in data if x.get('should_trigger') is False]
  check(len(data)>=24,'G2: fewer than 24 prompts'); check(len(yes)>=12,'G2: fewer than 12 positive prompts'); check(len(no)>=12,'G2: fewer than 12 negative prompts')
  check(all(isinstance(x.get('prompt'),str) and x['prompt'].strip() for x in data),'G2: malformed/empty prompt')
  check(all(x.get('language')=='EN' for x in data),'G2: all trigger records must be English-only')
 except Exception as e: check(False,f'G2: triggers.json invalid: {e}')
 try:
  data=json.loads((ROOT/'evals'/'scenarios.json').read_text(encoding='utf-8')); check(len(data)>=10,'G3: fewer than 10 scenarios')
  for x in data:
   check(bool(x.get('id')) and bool(x.get('prompt')),'G3: scenario missing identity/prompt'); check(len(x.get('rubric',[]))>=3,f"G3: {x.get('id')} has too few rubric items")
   check((ROOT/'evals'/'scenarios'/f"{x.get('id')}.md").is_file(),f"G3: missing detail file {x.get('id')}")
 except Exception as e: check(False,f'G3: scenarios.json invalid: {e}')
 for rel in ['plugin.json','.claude-plugin/plugin.json','.claude-plugin/marketplace.json','.codex-plugin/plugin.json']:
  try: json.loads((ROOT/rel).read_text(encoding='utf-8')); check(True,f'JSON valid {rel}')
  except Exception as e: check(False,f'G1: invalid {rel}: {e}')
 try:
  portable=json.loads((ROOT/'plugin.json').read_text(encoding='utf-8'))
  package=json.loads((ROOT/'package.json').read_text(encoding='utf-8'))
  check(package.get('name')=='rcoder','G1: npm package name must be rcoder')
  check(package.get('bin',{}).get('rcoder')=='./scripts/rcoder.mjs','G1: npm rcoder binary mapping is missing')
  check((ROOT/'scripts/rcoder.mjs').is_file(),'G1: npm installer entry point is missing')
  check((ROOT/'install.ps1').is_file(),'G1: PowerShell irm bootstrap is missing')
  check(package.get('version')==portable.get('version'),'G7: npm package and portable plugin versions differ')
  check(portable.get('name')=='rcoder','G1: portable plugin name must be rcoder')
  check(portable.get('extensions',{}).get('com.openai',{}).get('onboardingSkill')=='./skills/rcoder/SKILL.md','G1: portable plugin onboarding path mismatch')
  check((ROOT/'skills/rcoder/SKILL.md').is_file(),'G1: portable plugin points to missing skill')
  version=portable.get('version'); compat=json.loads((ROOT/'.codex-plugin/plugin.json').read_text(encoding='utf-8'))
  claude=json.loads((ROOT/'.claude-plugin/plugin.json').read_text(encoding='utf-8'))
  marketplace=json.loads((ROOT/'.claude-plugin/marketplace.json').read_text(encoding='utf-8'))
  check(compat.get('version')==version,'G7: portable and Codex compatibility versions differ')
  check(claude.get('version')==version,'G7: Claude plugin version differs')
  check(marketplace.get('plugins',[{}])[0].get('version')==version,'G7: marketplace plugin version differs')
  changelog=(ROOT/'CHANGELOG.md').read_text(encoding='utf-8')
  check(f'[{version}]' in changelog,'G7: plugin version missing from CHANGELOG')
  skill_text=(ROOT/'skills/rcoder/SKILL.md').read_text(encoding='utf-8')
  check(re.search(r'(?m)^  version: "'+re.escape(version)+r'"
 except Exception as e: check(False,f'G1: portable plugin validation failed: {e}')
 executables=list((ROOT/'scripts').glob('*'))+[ROOT/'install.ps1',SKILL/'scripts'/'detect_stack.py']
 secrets=[re.compile(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----'),re.compile(r'\bAKIA[0-9A-Z]{16}\b'),re.compile(r'\bgh[pousr]_[A-Za-z0-9]{20,}\b'),re.compile(r'\bgithub_pat_[A-Za-z0-9_]{20,}\b')]
 unsafe=[re.compile(r'(?i)\b(?:curl|wget)\b[^\n]*\|\s*(?:sh|bash)\b'),re.compile(r'(?i)\bInvoke-Expression\b|\bIEX\s*\('),re.compile(r'(?i)\brm\s+-rf\s+/(?:\s|$)'),re.compile(r'(?i)\bgit\s+push\s+--force\b')]
 for q in executables:
  if not q.is_file(): continue
  text=q.read_text(encoding='utf-8',errors='replace')
  for pattern in secrets: check(not pattern.search(text),f'G5: possible secret pattern in {q.relative_to(ROOT)}')
  if q.name != 'validate-all':
   for pattern in unsafe: check(not pattern.search(text),f'G5: unsafe executable pattern in {q.relative_to(ROOT)}')
 for rel in ['LICENSE','docs/HANDOFF.md','README.md','docs/DECISIONS.md','docs/research-log.md','docs/ARCHITECTURE.md','docs/PROGRESS.md']:
  check((ROOT/rel).is_file(),f'Missing required file {rel}')
 for rel in ['README.md','docs/HANDOFF.md','docs/PROGRESS.md']:
  content=(ROOT/rel).read_text(encoding='utf-8',errors='replace')
  check('Bahasa Indonesia' not in content and 'serah-terima' not in content and 'bilingual' not in content.lower(),f'G6: non-English or bilingual content marker found in {rel}')
 print(f'RCoder validation: {count} checks')
 if errors:
  for e in errors: print('FAIL:',e)
  print(f'FAILED: {len(errors)} issue(s)'); return 1
 print('PASS: structure, English-only prompts, scenarios, links, manifests, package metadata, and selected security checks')
 print('NOTE: live model triggering and vendor-native plugin validation are separate gates.')
 return 0
if __name__=='__main__': raise SystemExit(main())
,skill_text) is not None,'G7: skill version differs from package metadata')
 except Exception as e: check(False,f'G1: portable plugin validation failed: {e}')
 executables=list((ROOT/'scripts').glob('*'))+[SKILL/'scripts'/'detect_stack.py']
 secrets=[re.compile(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----'),re.compile(r'\bAKIA[0-9A-Z]{16}\b'),re.compile(r'\bgh[pousr]_[A-Za-z0-9]{20,}\b'),re.compile(r'\bgithub_pat_[A-Za-z0-9_]{20,}\b')]
 unsafe=[re.compile(r'(?i)\b(?:curl|wget)\b[^\n]*\|\s*(?:sh|bash)\b'),re.compile(r'(?i)\bInvoke-Expression\b|\bIEX\s*\('),re.compile(r'(?i)\brm\s+-rf\s+/(?:\s|$)'),re.compile(r'(?i)\bgit\s+push\s+--force\b')]
 for q in executables:
  if not q.is_file(): continue
  text=q.read_text(encoding='utf-8',errors='replace')
  for pattern in secrets: check(not pattern.search(text),f'G5: possible secret pattern in {q.relative_to(ROOT)}')
  if q.name != 'validate-all':
   for pattern in unsafe: check(not pattern.search(text),f'G5: unsafe executable pattern in {q.relative_to(ROOT)}')
 for rel in ['LICENSE','docs/HANDOFF.md','README.md','docs/DECISIONS.md','docs/research-log.md','docs/ARCHITECTURE.md','docs/PROGRESS.md']:
  check((ROOT/rel).is_file(),f'Missing required file {rel}')
 print(f'RCoder validation: {count} checks')
 if errors:
  for e in errors: print('FAIL:',e)
  print(f'FAILED: {len(errors)} issue(s)'); return 1
 print('PASS: structural, trigger-count, scenario, link, manifest, and selected security checks')
 print('NOTE: live model triggering and vendor-native plugin validation are separate gates.')
 return 0
if __name__=='__main__': raise SystemExit(main())
