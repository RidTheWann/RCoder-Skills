#!/usr/bin/env python3
"""Offline structural, routing, packaging, and selected security checks for RCoder."""
import hashlib
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKILL = ROOT / "skills" / "rcoder"
ERRORS = []
CHECKS = 0

def check(condition, message):
    global CHECKS
    CHECKS += 1
    if not condition:
        ERRORS.append(message)

def read(path):
    return path.read_text(encoding="utf-8", errors="replace")

def load_json(path):
    try:
        return json.loads(read(path))
    except Exception as error:
        check(False, f"Invalid JSON {path.relative_to(ROOT)}: {error}")
        return {}

def parse_frontmatter(path):
    content = read(path)
    if not content.startswith("---\n") or "\n---\n" not in content[4:]:
        return {}, content
    end = content.find("\n---\n", 4)
    values = {}
    for line in content[4:end].splitlines():
        if line.strip() and ":" in line:
            key, value = line.strip().split(":", 1)
            value = value.strip()
            if value.startswith('"') and value.endswith('"'):
                try:
                    value = json.loads(value)
                except json.JSONDecodeError:
                    value = value[1:-1]
            elif value.startswith("'") and value.endswith("'"):
                value = value[1:-1]
            values[key.strip()] = value
    return values, content[end + 5:]

def main():
    scripts_dir = str(ROOT / "scripts")
    if scripts_dir not in sys.path:
        sys.path.insert(0, scripts_dir)
    try:
        import sync_plugins
        import subprocess
        synced = subprocess.run(
            [sys.executable, str(ROOT / "scripts" / "sync_plugins.py"), "--check"],
            capture_output=True, text=True, encoding="utf-8", errors="replace",
        )
        check(synced.returncode == 0,
              "G1: sync_plugins --check must report command mirrors and manifests in sync\n" + synced.stdout + synced.stderr)
        canonical = sorted(p.stem for p in (SKILL / "commands").glob("*.md"))
        check(all((COMMANDS_DIR := ROOT / "commands" / "rcoder" / f"{slug}.toml").is_file() for slug in canonical),
              "G1: every canonical command must have a Gemini CLI TOML mirror")
        missing = [str(p.relative_to(ROOT)) for p in sync_plugins.REQUIRED_MANIFESTS if not p.is_file()]
        check(not missing, "G1: required plugin manifest missing: " + ", ".join(missing))
    except (ImportError, OSError, ValueError, RuntimeError) as error:
        check(False, f"G1: single-source plugin sync failed: {error}")

    skill_file = SKILL / "SKILL.md"
    check(skill_file.is_file(), "G1: missing skills/rcoder/SKILL.md")
    if not skill_file.is_file():
        return 1

    meta, body = parse_frontmatter(skill_file)
    version = str(meta.get("version", ""))
    check(bool(re.fullmatch(r"\d+\.\d+\.\d+", version)), "G7: SKILL.md version is not a semantic version")
    check(meta.get("name") == "rcoder", "G1: skill name must be rcoder")
    check(bool(re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", str(meta.get("name", "")))), "G1: invalid skill name")
    check(isinstance(meta.get("description"), str) and 1 <= len(meta["description"]) <= 1024,
          "G1: description length must be 1..1024")
    check(len(read(skill_file).splitlines()) <= 300, "G1: SKILL.md exceeds 300 lines")
    check(0 < len(read(skill_file).encode("utf-8")) < 4096,
          "G9: SKILL.md routing kernel must remain below 4 KiB")
    check(bool(body.strip()), "G1: empty skill instructions")
    check(f'version: "{version}"' in read(skill_file), "G7: skill version metadata differs")

    references = sorted((SKILL / "references").glob("*.md"))
    check(len(references) >= 50, "G1: fewer than 50 specialist references")
    for module in references:
        content = read(module)
        check(len(content.splitlines()) <= 300, f"G1: {module.name} exceeds 300 lines")
        for heading in (
            "## Activate when", "## Mission and expertise", "## Mental model",
            "## Prerequisites and reconnaissance", "## Procedure", "## Decision tree",
            "## Tool strategy", "## Advanced techniques", "## Failure modes",
            "## Quality checklist", "## Anti-patterns", "## Verification",
            "## Output format",
        ):
            check(heading in content, f"G1: {module.name} missing {heading}")
        sections = re.split(r"\n(?=## )", content)
        bodies = {part.splitlines()[0].strip(): part for part in sections if part.startswith("## ")}
        for heading in (
            "## Mission and expertise", "## Mental model", "## Procedure",
            "## Decision tree", "## Failure modes", "## Anti-patterns", "## Verification",
        ):
            body = bodies.get(heading, "")
            check(len(body.split()) >= 8, f"G1: {module.name} {heading} lacks substantive content")
        check(not re.search(r"(?m)^\s*(TODO|TBD|FIXME)\s*$", content),
              f"G1: {module.name} contains an unfilled placeholder")
        check(not re.search(r"(?i)\b(?:TODO|TBD|FIXME)\b", content),
              f"G1: {module.name} contains a todo marker")
        check(not re.search(r"<[A-Z][A-Za-z /-]{2,40}>", content),
              f"G1: {module.name} contains an unfilled template placeholder")
        for name, part in bodies.items():
            text = "\n".join(part.splitlines()[1:]).strip()
            check(len(text) >= 25, f"G1: {module.name} {name} body is empty or boilerplate")
        check("## Output format" in content and "## Verification" in content,
              f"G1: {module.name} missing output or verification contract")
        diagnostics = bodies.get("## Executable Verification & Failure Diagnostics", "")
        check(bool(diagnostics), f"G1: {module.name} missing executable verification footer")
        for label in ("- **Verify**:", "- **Anti-Patterns**:", "- **Failure Diagnostics**:"):
            check(label in diagnostics, f"G1: {module.name} verification footer lacks {label}")
        check("->" in diagnostics, f"G1: {module.name} failure diagnostics lacks a symptom -> cause -> action chain")
        check(not re.search(r"<[A-Z][A-Za-z /-]{2,40}>", diagnostics),
              f"G1: {module.name} verification footer contains an unfilled placeholder")
    for required in (
        "programming-languages.md", "systems-programming.md", "polyglot-ecosystems.md",
        "python-engineering.md", "javascript-typescript.md", "dotnet-java-engineering.md",
        "go-engineering.md", "frontend-engineering.md", "backend-api-engineering.md",
        "database-engineering.md", "mobile-engineering.md", "game-engineering.md",
        "embedded-engineering.md", "ml-ai-engineering.md", "distributed-systems-engineering.md",
        "threat-modeling.md", "secure-code-review.md", "application-security.md",
        "cloud-container-security.md", "network-security.md", "identity-crypto-secrets.md",
        "supply-chain-security.md", "vulnerability-research.md", "penetration-testing.md",
        "incident-response-forensics.md", "malware-analysis.md", "cryptography-engineering.md",
        "smart-contract-security.md", "reverse-engineering.md",
        "reverse-engineering-architecture.md", "reverse-engineering-file-formats.md",
        "token-efficiency.md", "web-platform-engineering.md", "model-adaptation.md",
        "rsaver.md", "rsaver-gate.md", "rsaver-anchor.md", "rsaver-crosscheck.md",
        "rscan.md", "agent-extensions-engineering.md", "llm-agent-security.md",
        "observability-sre.md", "android-platform-engineering.md",
        "windows-platform-engineering.md", "iac-platform-engineering.md",
        "graphics-gpu-engineering.md", "deterministic-routing.md",
        "weak-model-profile.md", "repo-map.md"
    ):
        check((SKILL / "references" / required).is_file(), f"G1: required specialist missing: {required}")

    check((SKILL / "scripts" / "detect_stack.py").is_file(), "G1: stack detector missing")
    check((SKILL / "scripts" / "context_snapshot.py").is_file(), "G1: context snapshot helper missing")
    check((SKILL / "assets" / "templates" / "expert-module-template.md").is_file(),
          "G1: expert module template missing")
    check((SKILL / "assets" / "templates" / "context-capsule-template.md").is_file(),
          "G1: context capsule template missing")

    link_pattern = re.compile(r"\]\(([^)]+)\)")
    for markdown in ROOT.rglob("*.md"):
        if any(part in {".git", "node_modules", ".rcoder"}
               for part in markdown.relative_to(ROOT).parts):
            continue
        for raw in link_pattern.findall(read(markdown)):
            target = raw.strip().split()[0].strip("<>")
            if not target or target.startswith(("http://", "https://", "mailto:", "#")):
                continue
            target = target.split("#", 1)[0]
            if target:
                check((markdown.parent / target).resolve().exists(),
                      f"G1: broken link {markdown.relative_to(ROOT)} -> {target}")
    for markdown in references:
        for target in link_pattern.findall(read(markdown)):
            check(not target.split("#", 1)[0].startswith("references/"),
                  f"G1: chained reference link in {markdown.name}")

    triggers = load_json(ROOT / "evals" / "triggers.json")
    positive = [item for item in triggers if item.get("should_trigger") is True]
    negative = [item for item in triggers if item.get("should_trigger") is False]
    check(len(triggers) >= 42, "G2: fewer than 42 trigger prompts")
    check(len(positive) >= 24, "G2: fewer than 24 positive prompts")
    check(len(negative) >= 18, "G2: fewer than 18 negative prompts")
    check(len({item.get("id") for item in triggers}) == len(triggers), "G2: duplicate trigger IDs")
    check(all(isinstance(item.get("prompt"), str) and item["prompt"].strip() for item in triggers),
          "G2: malformed or empty trigger prompt")
    check(all(item.get("language") == "EN" for item in triggers),
          "G2: trigger prompts must be English-only")
    expectations = load_json(ROOT / "evals" / "routing-expectations.json").get("expectations", {})
    check(set(expectations) == {item.get("id") for item in triggers},
          "G2: routing expectations must cover exactly the trigger IDs")

    scenarios = load_json(ROOT / "evals" / "scenarios.json")
    check(len(scenarios) >= 14, "G3: fewer than 14 behavioral scenarios")
    check(len({item.get("id") for item in scenarios}) == len(scenarios), "G3: duplicate scenario IDs")
    for scenario in scenarios:
        scenario_id = scenario.get("id", "")
        check(bool(scenario_id) and bool(scenario.get("prompt")), "G3: scenario missing ID/prompt")
        check(len(scenario.get("rubric", [])) >= 4, f"G3: {scenario_id} has too few rubric items")
        fixture = ROOT / "evals" / "scenarios" / f"{scenario_id}.md"
        check(fixture.is_file(), f"G3: missing scenario fixture {scenario_id}")
        if fixture.is_file():
            check(len(read(fixture)) >= 80, f"G3: scenario fixture too short: {scenario_id}")
    for required in ("score-eval.py", "test-score-eval.py", "test-route-predict.py", "test-repo-map.py"):
        check((ROOT / "scripts" / required).is_file(), f"G3: evaluation harness missing: {required}")
    check((ROOT / "evals" / "ABLATION-PROTOCOL.md").is_file(),
          "G3: ablation protocol missing")

    expanded_dir = ROOT / "evals" / "datasets" / "expanded"
    expanded_triggers = load_json(expanded_dir / "triggers.json")
    expanded_expectations = load_json(expanded_dir / "routing-expectations.json").get("expectations", {})
    expanded_scenarios = load_json(expanded_dir / "scenarios.json")
    check(len(expanded_triggers) >= 18, "G3: fewer than 18 expanded trigger prompts")
    check(len({item.get("id") for item in expanded_triggers}) == len(expanded_triggers),
          "G3: duplicate expanded trigger IDs")
    check(set(expanded_expectations) == {item.get("id") for item in expanded_triggers},
          "G3: expanded expectations must cover exactly the expanded trigger IDs")
    check(all(item.get("language") == "EN" for item in expanded_triggers),
          "G3: expanded canonical dataset must remain English-only")
    check(sum(item.get("should_trigger") is False for item in expanded_triggers) >= 6,
          "G3: expanded dataset lost negative control cases")
    module_names = {path.stem for path in references}
    for item_id, names in expanded_expectations.items():
        check(isinstance(names, list) and all(name in module_names for name in names),
              f"G3: expanded expectation {item_id} references an unknown specialist")
    for scenario in expanded_scenarios:
        sid = scenario.get("id", "")
        check(len(scenario.get("rubric", [])) >= 4, f"G3: expanded scenario {sid} has too few rubric items")
        check((expanded_dir / "scenarios" / f"{sid}.md").is_file(),
              f"G3: missing expanded scenario fixture {sid}")

    multilingual = load_json(ROOT / "evals" / "datasets" / "multilingual.triggers.json")
    check(len(multilingual) >= 12, "G3: multilingual research dataset too small")
    check(len({item.get("id") for item in multilingual}) == len(multilingual),
          "G3: duplicate multilingual case IDs")
    check({item.get("language") for item in multilingual} >= {"ID", "EN", "MIXED_ID_EN"},
          "G3: multilingual dataset must include Indonesian, English, and mixed prompts")
    check(sum(not item.get("expected_specialists") for item in multilingual) >= 3,
          "G3: multilingual negative controls were lost")
    for item in multilingual:
        check(item.get("language") in {"ID", "EN", "MIXED_ID_EN"},
              f"G3: multilingual case {item.get('id')} has an invalid language tag")
        check(all(name in module_names for name in item.get("expected_specialists", [])),
              f"G3: multilingual case {item.get('id')} references an unknown specialist")
        prompt = item.get("prompt", "")
        check(bool(prompt.strip()), f"G3: multilingual case {item.get('id')} has empty prompt")
        check(all(isinstance(token, str) and token and token in prompt
                  for token in item.get("identifier_integrity", [])),
              f"G3: multilingual case {item.get('id')} changed or omitted an identifier")
    check((ROOT / "scripts" / "test-multilingual-data.py").is_file(),
          "G3: multilingual static fixture test missing")

    ledger = read(ROOT / "evals" / "runs" / "BASELINE-LEDGER.md")
    for digest, filename in re.findall(r"`([0-9a-f]{64})`\s*\|\s*([A-Za-z0-9_.-]+)", ledger):
        control = ROOT / "evals" / "runs" / "hy4-flash-openrouter-2026-11-19" / filename
        normalized = control.read_bytes().replace(b"\r\n", b"\n") if control.is_file() else b""
        check(control.is_file() and hashlib.sha256(normalized).hexdigest() == digest,
              f"G3: immutable control dataset changed: {filename}")

    manifest_paths = (
        "plugin.json", ".claude-plugin/plugin.json",
        ".claude-plugin/marketplace.json", ".codex-plugin/plugin.json",
        "gemini-extension.json"
    )
    manifests = {path: load_json(ROOT / path) for path in manifest_paths}
    package = load_json(ROOT / "package.json")
    contract = load_json(SKILL / "contracts" / "rcoder-v2.json")
    catalog = load_json(ROOT / "targets.json")
    portable = manifests["plugin.json"]
    codex_marketplace = load_json(ROOT / ".agents" / "plugins" / "marketplace.json")
    claude_mcp = load_json(ROOT / ".mcp.json")
    portable_mcp = load_json(ROOT / "mcp.json")

    check(package.get("name") == "rcoder", "G1: npm package name must be rcoder")
    check(package.get("version") == version, "G7: npm package version mismatch")
    check(contract.get("product", {}).get("version") == version, "G7: shared contract product version mismatch")
    check(contract.get("mcp", {}).get("modern_protocol") == "2026-07-28", "G8: modern MCP protocol version mismatch")
    check(contract.get("mcp", {}).get("transports", {}).get("streamable_http", {}).get("bind_host") == "127.0.0.1",
          "G8: Streamable HTTP must declare loopback binding")
    check(manifests["gemini-extension.json"].get("version") == version,
          "G7: Gemini extension version mismatch")
    check(manifests["gemini-extension.json"].get("name") == "rcoder",
          "G8: Gemini extension name mismatch")
    check(manifests[".claude-plugin/plugin.json"].get("mcpServers") == "./.mcp.json",
          "G8: Claude plugin must reference its bundled compatibility MCP config")
    check(manifests[".codex-plugin/plugin.json"].get("mcpServers") == "./.mcp.json",
          "G8: Codex compatibility plugin must reference its bundled MCP config")
    check(manifests[".codex-plugin/plugin.json"].get("skills") == "./skills/",
          "G8: Codex compatibility plugin must expose the bundled skills directory")
    check(codex_marketplace.get("plugins", [{}])[0].get("source", {}).get("url") ==
          "https://github.com/RidTheWann/RCoder-Skills",
          "G8: Codex marketplace must point to the actual repository source")
    check(codex_marketplace.get("plugins", [{}])[0].get("policy", {}).get("installation") == "AVAILABLE",
          "G8: Codex marketplace plugin must be installable")
    gemini_mcp = manifests["gemini-extension.json"].get("mcpServers", {}).get("rcoder", {})
    check(bool(gemini_mcp.get("command")) and any("extensionPath" in str(arg) for arg in gemini_mcp.get("args", [])),
          "G8: Gemini extension MCP server must use its extension-root launcher")
    check(manifests["gemini-extension.json"].get("contextFileName") == "GEMINI.md",
          "G8: Gemini extension context file is not declared")
    check(portable_mcp.get("mcpServers", {}).get("rcoder", {}).get("type") == "stdio",
          "G8: portable plugin MCP transport must be stdio")
    check(portable_mcp.get("mcpServers", {}).get("rcoder", {}).get("command") == "node",
          "G8: portable plugin must use the cross-platform Node MCP launcher")
    check(claude_mcp.get("mcpServers", {}).get("rcoder", {}).get("command") == "node",
          "G8: Claude/Codex compatibility MCP config must use Node launcher")
    check((ROOT / ".opencode" / "plugins" / "rcoder.js").is_file(),
          "G8: OpenCode V1 adapter missing")
    opencode_plugin = read(ROOT / ".opencode" / "plugins" / "rcoder.js")
    check("experimental.chat.system.transform" in opencode_plugin and "RCoder:" in opencode_plugin,
          "G8: OpenCode adapter must inject bounded RCoder guidance through the V1 hook")
    check("mcp-transport-engineering.md" in read(skill_file),
          "G8: SKILL.md must route to MCP transport engineering")
    check("Multilingual activation" in read(skill_file),
          "G8: SKILL.md must define the multilingual activation contract")
    check(package.get("bin", {}).get("rcoder") == "./scripts/rcoder.mjs", "G1: npm rcoder binary missing")
    package_files = set(package.get("files", []))
    for required in ("skills/rcoder/**", "scripts/rcoder.mjs", "targets.json", "launcher/RCoder.ps1"):
        check(required in package_files, f"G1: npm package missing runtime file pattern {required}")
    for required in (
        "scripts/rcoder.mjs", "scripts/install.ps1", "scripts/install.sh",
        "scripts/test-node-installer.mjs", "scripts/test-installers.sh",
        "scripts/test-installers.ps1", "scripts/test-context-snapshot.py", "scripts/rsaver.py",
        "runtime/Cargo.toml", "runtime/crates/runtime-core/Cargo.toml",
        "runtime/crates/runtime-core/src/lib.rs", "runtime/crates/runtime-core/src/discovery.rs",
        "runtime/crates/runtime-core/src/session.rs", "runtime/crates/runtime-core/src/task.rs",
        "runtime/crates/runtime-core/src/instruction.rs",
        "runtime/apps/rcoder-runtime/Cargo.toml",
        "runtime/apps/rcoder-runtime/src/main.rs", "skills/rcoder/scripts/runtime_bootstrap.py",
        "skills/rcoder/scripts/runtime_task_host.py", "skills/rcoder/references/rcoder-runtime.md",
        "scripts/test-runtime-bootstrap.py", "scripts/test-runtime-task-host.py", "docs/RUNTIME.md",
        "skills/rcoder/scripts/rsaver.py", "scripts/test-rsaver.py",
        "skills/rcoder/scripts/rsaver_guard.py",
        "scripts/rscan.py", "skills/rcoder/scripts/rscan.py", "scripts/test-rscan.py",
        "skills/rcoder/scripts/rscan_graph.py", "scripts/test-v2-upgrades.py",
        ".gitattributes", "skills/rcoder/scripts/platform_runtime.py",
        "skills/rcoder/scripts/rscan_index.py", "scripts/test-cross-platform.py",
        "skills/rcoder/scripts/rsaver_sandbox.py", "skills/rcoder/scripts/rcoder_memory.py",
        "skills/rcoder/scripts/rcoder_swarm.py", "scripts/verify_parity.py",
        "scripts/test-autonomous-v3.py", "scripts/sync_plugins.py",
        "scripts/score-eval.py", "scripts/test-score-eval.py", "scripts/score-scenarios.py",
        "scripts/test-score-scenarios.py", "scripts/verify-objective.py", "scripts/test-objective.py",
        "scripts/test-tool-probe.py", "skills/rcoder/scripts/tool_probe.py",
        "scripts/check-dist.py", "scripts/test-package-hygiene.py", "scripts/test-mcp.py", "scripts/rcoder-mcp.py",
        "skills/rcoder/scripts/rcoder_mcp.py", "skills/rcoder/scripts/rcoder_mcp_modern.py",
        "skills/rcoder/scripts/rcoder_mcp_http.py", "scripts/test-mcp-modern.py",
        "install.ps1", "launcher/RCoder.ps1", "launcher/McpSetup.ps1", "targets.json",
        "skills/rcoder/scripts/rcoder_mcp_setup.py", "scripts/test-mcp-setup.py",
        "skills/rcoder/contracts/rcoder-v2.json", "skills/rcoder/scripts/rcoder_contract.py",
        "scripts/test-mcp-contract.py", "scripts/test-mcp-http.py", "scripts/test-cli-doctor.mjs",
        "scripts/test-installer-menus.py", "scripts/test-integrations.mjs",
        "scripts/test-skill-authoring.py", "scripts/test-cli-skill.mjs",
        "scripts/test-multilingual-data.py",
        "skills/rcoder/scripts/route_predict.py", "scripts/test-route-predict.py",
        "skills/rcoder/scripts/repo_map.py", "scripts/repo-map.py", "scripts/test-repo-map.py",
        "evals/dataset-heldout.json", "skills/rcoder/references/deterministic-routing.md",
        "skills/rcoder/scripts/skill_authoring.py", "skills/rcoder/references/mcp-transport-engineering.md",
        "launcher/rcoder-mcp.mjs", ".opencode/plugins/rcoder.js", "gemini-extension.json",
        "GEMINI.md", ".mcp.json", "mcp.json", ".agents/plugins/marketplace.json"
    ):
        check((ROOT / required).is_file(), f"G1: required installer/test file missing: {required}")

    attributes = read(ROOT / ".gitattributes")
    check("* text=auto eol=lf" in attributes and "*.ps1 text eol=crlf" in attributes,
          "G1: .gitattributes must lock LF scripts and CRLF PowerShell files")
    parity_source = read(ROOT / "scripts" / "verify_parity.py")
    check(all(token in parity_source for token in ("CASE_COLLISION", "CRLF_LEAK", "HARDCODED_OS_PATH")),
          "G1: parity linter must detect case collisions, CRLF leaks, and absolute paths")

    check(portable.get("version") == version, "G7: portable plugin version mismatch")
    check(portable.get("name") == "rcoder", "G1: portable plugin name mismatch")
    check(portable.get("extensions", {}).get("com.openai", {}).get("onboardingSkill") ==
          "./skills/rcoder/SKILL.md", "G1: portable plugin onboarding path mismatch")
    check(manifests[".codex-plugin/plugin.json"].get("version") == version,
          "G7: Codex compatibility version mismatch")
    check(manifests[".claude-plugin/plugin.json"].get("version") == version,
          "G7: Claude plugin version mismatch")
    check(manifests[".claude-plugin/marketplace.json"].get("plugins", [{}])[0].get("version") == version,
          "G7: marketplace plugin version mismatch")
    check(f"[{version}]" in read(ROOT / "CHANGELOG.md"), "G7: version missing from changelog")
    check(f"VERSION = '{version}'" in read(ROOT / "scripts" / "package"),
          "G7: package builder version mismatch")

    targets = catalog.get("targets", [])
    target_ids = [item.get("id") for item in targets]
    required_ids = {
        "claude-code", "codex", "cursor", "gemini-cli", "copilot", "agents",
        "qoder", "opencode", "antigravity", "amp", "zed", "pi", "openclaw",
        "autohand", "warp", "kilocode", "cline", "roo-code", "trae", "factory"
    }
    check(len(targets) == 20, "G4: target catalog must contain exactly 20 hosts")
    check(len(set(target_ids)) == len(target_ids), "G4: duplicate target IDs")
    check(required_ids.issubset(set(target_ids)), "G4: one or more required hosts are missing")
    for item in targets:
        for key in ("project_root", "user_root"):
            value = item.get(key, "")
            normalized = value.replace(chr(92), "/") if isinstance(value, str) else ""
            check(isinstance(value, str) and bool(value) and not value.startswith("/") and not value.startswith(chr(92)),
                  f"G4: invalid {key} for {item.get('id')}")
            check(".." not in normalized.split("/"), f"G4: path traversal in target {item.get('id')}")

    root_installer = read(ROOT / "install.ps1")
    ps_installer = read(ROOT / "scripts" / "install.ps1")
    posix_installer = read(ROOT / "scripts" / "install.sh")
    node_cli = read(ROOT / "scripts" / "rcoder.mjs")
    ps_launcher = read(ROOT / "launcher" / "RCoder.ps1")
    for target_id in required_ids:
        check(target_id in root_installer, f"G4: root PowerShell bootstrap missing target {target_id}")
        check(target_id in ps_installer, f"G4: PowerShell helper missing target {target_id}")
        check(target_id in posix_installer, f"G4: POSIX helper missing target {target_id}")
    check("TARGET_BY_ID" in node_cli and "TARGETS = CATALOG.targets" in node_cli,
          "G4: Node CLI must resolve host IDs from the target catalog")
    check("targets.json" in node_cli and "targets.json" in ps_launcher,
          "G4: interactive managers must use the target catalog")
    check("--interactive" in node_cli and "rcoder" in root_installer,
          "G4: global rcoder launcher wiring missing")
    check("legacyBackupRoot" in node_cli and "legacyBackupRoot" in ps_launcher,
          "G4: shared-root/legacy-backup compatibility missing")
    check("legacyBackup" in ps_installer and "LEGACY_BACKUP" in posix_installer,
          "G4: offline installers must preserve legacy backups")
    for label, content in (("Node CLI", node_cli), ("root PowerShell bootstrap", root_installer),
                           ("PowerShell helper", ps_installer), ("POSIX helper", posix_installer),
                           ("PowerShell launcher", ps_launcher)):
        check("rsaver" in content.lower() and "rscan" in content.lower(),
              f"G4: {label} must expose RSaver and RScan optional tool selection")

    executables = list((ROOT / "scripts").glob("*")) + [
        ROOT / "install.ps1", ROOT / "launcher" / "RCoder.ps1", ROOT / "launcher" / "McpSetup.ps1",
        SKILL / "scripts" / "rcoder_mcp_setup.py",
        SKILL / "scripts" / "detect_stack.py", SKILL / "scripts" / "context_snapshot.py",
        SKILL / "scripts" / "rcoder_mcp.py", SKILL / "scripts" / "rcoder_mcp_modern.py"
    ]
    secret_patterns = [
        re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----"),
        re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
        re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b"),
        re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b")
    ]
    unsafe_patterns = [
        re.compile(r"(?i)\b(?:curl|wget)\b[^\n]*\|\s*(?:sh|bash)\b"),
        re.compile(r"(?i)\bInvoke-Expression\b|\bIEX\s*\("),
        re.compile(r"(?i)\brm\s+-rf\s+/(?:\s|$)"),
        re.compile(r"(?i)\bgit\s+push\s+--force\b")
    ]
    for path in executables:
        if not path.is_file():
            continue
        content = read(path)
        for pattern in secret_patterns:
            check(not pattern.search(content), f"G5: possible secret pattern in {path.relative_to(ROOT)}")
        if path.name != "validate-all":
            for pattern in unsafe_patterns:
                check(not pattern.search(content), f"G5: risky installer command pattern in {path.relative_to(ROOT)}")

    for required in (
        "LICENSE", "README.md", "CHANGELOG.md", "docs/HANDOFF.md",
        "docs/DECISIONS.md", "docs/research-log.md", "docs/ARCHITECTURE.md",
        "docs/PROGRESS.md",         "docs/RESEARCH-TODO.md",
        "docs/COMPATIBILITY.md", "docs/ENVIRONMENT.md", "docs/TOKEN-ECONOMICS.md",
        "docs/CONTEXT-DRIFT.md", "docs/RSCAN-HOOKS.md",
        "docs/BILLING-AND-CROSSCHECK.md", "docs/LIVE-BENCHMARK.md",
        "evals/EVALUATION-INDEPENDENCE.md", "evals/MULTILINGUAL-POLICY.md",
        "evals/runs/BASELINE-LEDGER.md", "docs/V1.12-DELIVERY.md",
        "docs/V1.13-DEV-LEDGER.md", "docs/V1.13-DELIVERY.md", "docs/MCP.md"
    ):
        check((ROOT / required).is_file(), f"G6: required documentation missing: {required}")
    for rel in ("README.md", "docs/HANDOFF.md", "docs/PROGRESS.md"):
        content = read(ROOT / rel)
        check("Bahasa Indonesia" not in content and "serah-terima" not in content and
              "bilingual" not in content.lower(),
              f"G6: non-English/bilingual marker in {rel}")

    # G8: MCP server, plugin components, and extension manifests
    server_path = SKILL / "scripts" / "rcoder_mcp.py"
    server_src = read(server_path) if server_path.is_file() else ""
    check(bool(server_src), "G8: MCP server source missing")
    check("shell=True" not in server_src and "os.system(" not in server_src,
          "G8: MCP server must invoke helpers with an argument vector, never a shell")
    check("realpath" in server_src and "outside the server root" in server_src,
          "G8: MCP server path confinement missing")
    check(not re.search(r"(?m)^\s*(?:import|from)\s+(?:mcp|requests|httpx|pydantic)\b", server_src),
          "G8: MCP server must stay dependency-free")
    check("urllib" not in server_src and "import socket" not in server_src,
          "G8: MCP server must not open network connections")
    if server_src:
        import importlib.util
        spec = importlib.util.spec_from_file_location("rcoder_mcp_under_validation", server_path)
        server_module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(server_module)
        helper_line = re.search(r"Helpers \(([^)]*)\)", read(skill_file))
        helper_names = set(re.findall(r"([a-z0-9-]+)", helper_line.group(1))) if helper_line else set()
        check(helper_names == set(server_module.HELPER_MODULES),
              "G8: MCP helper set differs from the SKILL.md routing rule")
        known_modules = {path.stem for path in references}
        for label in ("HELPER_MODULES", "SECURITY_FAMILY", "LANGUAGE_MODULES", "PLATFORM_MODULES",
                      "CONTEXT_MODULES"):
            stale = set(getattr(server_module, label)) - known_modules
            check(not stale, f"G8: MCP {label} names a module that is not on disk: {sorted(stale)}")
        check(server_module.product_version() == version, "G7: MCP server version differs from SKILL.md")
        check(len(server_module.TOOLS) == len({item[0] for item in server_module.TOOLS}),
              "G8: duplicate MCP tool names")
        for item in server_module.TOOLS:
            check(item[3].get("additionalProperties") is False, f"G8: MCP tool {item[0]} schema is not strict")
    check("agent-extensions-engineering.md" in read(skill_file),
          "G8: SKILL.md does not route to agent-extensions-engineering")
    check("rcoder_mcp.py" in read(skill_file), "G8: SKILL.md does not document the MCP server")

    for kind, directory in (("command", ROOT / "commands"), ("agent", ROOT / "agents")):
        files = sorted(directory.glob("*.md"))
        check(len(files) >= 4, f"G8: fewer than 4 plugin {kind} files")
        for file in files:
            front, body = parse_frontmatter(file)
            check(bool(front.get("description")), f"G8: {kind} {file.name} lacks a description")
            check(len(body.split()) >= 25, f"G8: {kind} {file.name} body is too short")
            check("allowed-tools" not in front, f"G8: {kind} {file.name} must not pre-approve tools")
            check(not re.search(r"(?i)\b(?:TODO|TBD|FIXME)\b", read(file)),
                  f"G8: {kind} {file.name} has a todo marker")
            if kind == "agent":
                check(front.get("name") == file.stem and bool(re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", file.stem)),
                      f"G8: agent {file.name} name must match its file name")
                granted = {item.strip() for item in front.get("tools", "").split(",") if item.strip()}
                check(bool(granted), f"G8: agent {file.name} must declare a least-privilege tools list")
                check(not granted & {"Write", "Edit", "MultiEdit", "NotebookEdit"},
                      f"G8: agent {file.name} must not be granted file-editing tools")
                if file.stem == "rcoder-security-reviewer":
                    check("Bash" not in granted, "G8: the security reviewer must stay passive (no Bash)")
    check({item.stem for item in (ROOT / "commands").glob("*.md")} >=
          {"scan", "route", "review", "verify", "handoff", "doctor"}, "G8: expected slash commands missing")
    launch = claude_mcp.get("mcpServers", {}).get("rcoder", {}).get("args", [])
    check(any("launcher/rcoder-mcp.mjs" in str(arg) for arg in launch),
          "G8: compatibility MCP launch does not point at the bundled cross-platform launcher")
    hooks_file = ROOT / "hooks" / "hooks.json"
    check(hooks_file.is_file(), "G8: plugin hooks/hooks.json missing (D-019)")
    hook_events = load_json(hooks_file).get("hooks", {}) if hooks_file.is_file() else {}
    check(set(hook_events) == {"SessionStart", "PreToolUse", "PostToolUse", "PreCompact", "UserPromptSubmit", "Stop", "SessionEnd"},
          "G8: plugin hook events must match the reviewed Claude lifecycle and RFC host set (D-019/D-024)")
    for entry in hook_events.get("SessionStart", []):
        check(entry.get("matcher") == "startup", "G8: the plugin hook must match startup only")
        for hook in entry.get("hooks", []):
            command = hook.get("command", "")
            check(hook.get("type") == "command" and 0 < hook.get("timeout", 0) <= 30,
                  "G8: the plugin hook must be a command with a timeout of at most 30 seconds")
            check("skills/rcoder/scripts/rscan.py" in command and " scan " in command
                  and "--hook claude" in command and not re.search(r"[;&|]\s*(?!\|)", command.replace("||", "")),
                  "G8: the plugin hook may only run the bundled read-only rscan scan")
            check(not re.search(r"(?i)\b(curl|wget|rm|sudo|eval|install)\b", command),
                  "G8: the plugin hook command contains a forbidden program")
    lifecycle_handlers = ROOT / "skills" / "rcoder" / "scripts" / "rcoder_hooks.py"
    handler_source = read(lifecycle_handlers) if lifecycle_handlers.is_file() else ""
    check(bool(handler_source) and all(token in handler_source for token in
          ("def decide_tool", "def post_tool_context", "def pre_compact_instructions")),
          "G8: shared Claude/Gemini lifecycle handler is incomplete (D-019/D-021)")
    expected_hook_handlers = {
        "PreToolUse": ("guard", "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Bash"),
        "PostToolUse": ("post-tool", ".*"),
        "PreCompact": ("pre-compact", "manual|auto"),
    }
    for event, (phase, matcher) in expected_hook_handlers.items():
        entries = hook_events.get(event, [])
        check(len(entries) == 1 and entries[0].get("matcher") == matcher,
              f"G8: {event} matcher must match the reviewed host configuration")
        handlers = entries[0].get("hooks", []) if entries else []
        command = handlers[0].get("command", "") if handlers else ""
        check(len(handlers) == 1 and handlers[0].get("type") == "command"
              and handlers[0].get("timeout") == 10 and phase in command
              and "skills/rcoder/scripts/rcoder_hooks.py" in command,
              f"G8: {event} must invoke the bundled {phase} handler with a bounded timeout")
    rfc_host = ROOT / "skills" / "rcoder" / "scripts" / "context_fabric_host.py"
    rfc_host_source = read(rfc_host) if rfc_host.is_file() else ""
    check(bool(rfc_host_source) and all(token in rfc_host_source for token in
          ("def handle_user_prompt_submit", "def handle_stop", "def handle_session_end",
           "hookSpecificOutput", "additionalContext", "last_assistant_message")),
          "G8: RFC Claude host adapter is incomplete (D-024)")
    expected_rfc_hooks = {
        "UserPromptSubmit": "user-prompt-submit",
        "Stop": "stop",
        "SessionEnd": "session-end",
    }
    for event, phase in expected_rfc_hooks.items():
        entries = hook_events.get(event, [])
        handlers = entries[0].get("hooks", []) if len(entries) == 1 else []
        command = handlers[0].get("command", "") if handlers else ""
        check(len(handlers) == 1 and handlers[0].get("type") == "command"
              and handlers[0].get("timeout") == 10 and phase in command
              and "skills/rcoder/scripts/context_fabric_host.py" in command,
              f"G8: {event} must invoke the bundled RFC host adapter with a bounded timeout")
    runtime_mcp = read(SKILL / "scripts" / "rcoder_mcp.py")
    runtime_http = read(SKILL / "scripts" / "rcoder_mcp_http.py")
    runtime_bootstrap = read(SKILL / "scripts" / "runtime_bootstrap.py")
    check('default=os.environ.get("RCODER_WORKSPACE_ROOT", ".")' in runtime_mcp
          and 'default=os.environ.get("RCODER_WORKSPACE_ROOT", ".")' in runtime_http,
          "G8: both MCP transports must honor the host-supplied workspace root")
    check("start_runtime_companion(State.root)" in runtime_mcp,
          "G8: local stdio MCP must activate the optional Runtime companion")
    check("start_runtime_companion(root)" in runtime_http
          and 'environment["RCODER_RUNTIME_DISABLE"] = "1"' in runtime_http
          and "worker_env = worker_environment(" in runtime_http
          and "def worker_environment(" in runtime_http,
          "G8: loopback HTTP MCP must own one Runtime session and suppress per-request worker sidecars")
    check("RCODER_RUNTIME_DISABLE" in runtime_bootstrap
          and "RCODER_RUNTIME_PATH" in runtime_bootstrap
          and "start_new_session" in runtime_bootstrap
          and '"env": runtime_environment()' in runtime_bootstrap,
          "G8: Runtime bootstrap must remain opt-out, configurable, and detached")
    check("D-025" in read(ROOT / "docs" / "DECISIONS.md")
          and (ROOT / "docs" / "RUNTIME.md").is_file(),
          "G8: D-025 and Runtime architecture docs must describe the local MCP lifecycle")
    runtime_task = read(ROOT / "runtime" / "crates" / "runtime-core" / "src" / "task.rs")
    runtime_cli = read(ROOT / "runtime" / "apps" / "rcoder-runtime" / "src" / "main.rs")
    runtime_docs = read(ROOT / "docs" / "RUNTIME.md")
    runtime_decisions = read(ROOT / "docs" / "DECISIONS.md")
    check("pub fn create_task(" in runtime_task and "pub fn record_evidence(" in runtime_task
          and "pub fn transition_task(" in runtime_task and "TaskStatus::Completed" in runtime_task,
          "G8: Runtime Task Controller must persist contracts, evidence, and guarded transitions")
    check("cannot complete task; acceptance criteria" in runtime_task
          and "latest_failing_evidence_reopens_a_completion_blocker" in runtime_task,
          "G8: task completion must require latest passing evidence for every criterion")
    check("completed_task_can_be_reopened_and_a_new_failure_blocks_completion" in runtime_task
          and "TaskStatus::Completed, TaskStatus::Active" in runtime_task
          and "a reason is required when blocking or reopening a task" in runtime_task,
          "G8: completed tasks must reopen only with a reason and re-enter the evidence gate")
    check("MAX_EVIDENCE_RECORDS" in runtime_task and "MAX_TRANSITIONS" in runtime_task,
          "G8: Runtime task evidence and transition histories must have explicit bounds")
    check('"Evidence history:"' in runtime_cli and '"State history:"' in runtime_cli,
          "G8: Runtime task inspection must display evidence and state-transition history")
    check("TaskCommand::Create" in runtime_cli and "TaskCommand::Evidence" in runtime_cli
          and "TaskCommand::Transition" in runtime_cli,
          "G8: Runtime CLI must expose task contract and evidence operations")
    check("rcoder-runtime.md" in read(skill_file)
          and (SKILL / "references" / "rcoder-runtime.md").is_file(),
          "G8: RCoder Skill must route contract-aware tasks to Runtime guidance")
    check("D-026" in runtime_decisions and "caller-supplied evidence attestations" in runtime_docs,
          "G8: Runtime task evidence boundary must be documented as caller-attested")
    runtime_instruction = read(ROOT / "runtime" / "crates" / "runtime-core" / "src" / "instruction.rs")
    check("pub fn compile_task(" in runtime_instruction
          and "MAX_INSTRUCTION_PACKET_BYTES: usize = 64 * 1024" in runtime_instruction
          and "digest_sha256" in runtime_instruction
          and "TaskStatus::Active" in runtime_instruction,
          "G8: Runtime instruction compiler must produce a bounded digest packet for active tasks only")
    check("compile_task" in runtime_cli and "TaskCommand::Compile" in runtime_cli
          and "task compile --project" in runtime_docs
          and "D-027" in runtime_decisions,
          "G8: instruction packet compilation must be exposed, documented, and recorded as a decision")
    check("identical_task_revisions_produce_identical_sha256_packets" in runtime_instruction
          and "compiler_rejects_oversized_packets_without_truncation" in runtime_instruction
          and "only_latest_evidence_per_criterion_is_compiled" in runtime_instruction,
          "G8: instruction compiler must test digest stability, size bounds, and latest evidence selection")
    check("compiler_digest_matches_host_canonical_serialization_fixture" in runtime_instruction
          and "test_digest_matches_the_rust_canonical_serialization_fixture" in read(ROOT / "scripts" / "test-runtime-task-host.py"),
          "G8: Runtime's Rust compiler digest must match the Claude hook's Python verifier")
    runtime_task_host = read(SKILL / "scripts" / "runtime_task_host.py")
    claude_hooks = json.loads(read(ROOT / "hooks" / "hooks.json"))["hooks"]
    check('subprocess.run(' in runtime_task_host and '"--active"' in runtime_task_host
          and "runtime_bootstrap.runtime_environment" in runtime_task_host
          and "RCODER_RUNTIME_DISABLE" in runtime_task_host
          and "additionalContext" in runtime_task_host,
          "G8: Claude Runtime hook must compile the active task with a sanitized, fail-open CLI bridge")
    check("_packet_digest" in runtime_task_host and "hmac.compare_digest" in runtime_task_host
          and "_contains_secret_like_value" in runtime_task_host,
          "G8: Claude Runtime hook must verify packet integrity and reject secret-like task contents")
    check(len(claude_hooks.get("UserPromptSubmit", [])) == 2
          and "runtime_task_host.py" in claude_hooks["UserPromptSubmit"][1]["hooks"][0]["command"]
          and claude_hooks["UserPromptSubmit"][1]["hooks"][0]["timeout"] == 6,
          "G8: Claude UserPromptSubmit must run RFC and Runtime context adapters independently")
    check("test-runtime-task-host.py" in read(ROOT / ".github" / "workflows" / "quality.yml"),
          "G8: Runtime task host regression suite must run in CI")
    runtime_discovery = read(ROOT / "runtime" / "crates" / "runtime-core" / "src" / "discovery.rs")
    workflow = read(ROOT / ".github" / "workflows" / "quality.yml")
    check("rcoder_mcp.py" in runtime_discovery and "rcoder-mcp.mjs" in runtime_discovery
          and "a_server_named_rcoder_without_the_rcoder_entrypoint" in runtime_discovery,
          "G8: Runtime discovery must require an actual RCoder entrypoint rather than an alias")
    check("cargo fmt --manifest-path runtime/Cargo.toml --all -- --check" in workflow
          and "cargo test --manifest-path runtime/Cargo.toml --workspace" in workflow
          and "components: rustfmt" in workflow,
          "G8: CI must install rustfmt and format/test the Runtime workspace")
    check("hooks/**" in package.get("files", []), "G8: the npm package must ship the hooks directory")
    check("D-019" in read(ROOT / "docs" / "DECISIONS.md") and "D-021" in read(ROOT / "docs" / "DECISIONS.md")
          and "D-024" in read(ROOT / "docs" / "DECISIONS.md")
          and (ROOT / "docs" / "HOOKS.md").is_file(),
          "G8: D-019/D-021 and docs/HOOKS.md must document lifecycle hook behavior")
    check("'hooks'" in read(ROOT / "scripts" / "package"),
          "G8: the Claude plugin archive must include the hooks directory")
    check("mcp" in package.get("keywords", []), "G8: npm keywords should include mcp")

    check(CHECKS >= 3060, "G0: validation check count fell below the expected floor")
    print(f"RCoder validation: {CHECKS} checks")
    if ERRORS:
        for error in ERRORS:
            print("FAIL:", error)
        print(f"FAILED: {len(ERRORS)} issue(s)")
        return 1
    print("PASS: skill structure, specialist routing, evaluation data, manifests, host catalog, installers, and selected security checks")
    print("NOTE: native host discovery and live model activation remain separate verification gates.")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
