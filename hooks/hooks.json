{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/rcoder_hooks.py\" guard || python \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/rcoder_hooks.py\" guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/rcoder_hooks.py\" post-tool || python \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/rcoder_hooks.py\" post-tool",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/rcoder_hooks.py\" pre-compact || python \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/rcoder_hooks.py\" pre-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/rscan.py\" scan --root \"${CLAUDE_PROJECT_DIR:-.}\" --hook claude || python \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/rscan.py\" scan --root \"${CLAUDE_PROJECT_DIR:-.}\" --hook claude",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/context_fabric_host.py\" user-prompt-submit || python \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/context_fabric_host.py\" user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/context_fabric_host.py\" stop || python \"${CLAUDE_PLUGIN_ROOT}/skills/rcoder/scripts/context_fabric_host.py\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
